   "source": [
    "## 타입 힌트는 함수의 매개변수와 변환값의 타입을 지정하는 목적으로 사용하며, 엄격한 타입 지정으로 인한 프로그래머의 의도를 명확히 전달하기 위함이다. 안써도 되지만 파이썬 13부터 쓰는 것을 권장하고 있다 "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "6835346b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "in great: 안녕\n",
      "안녕!\n"
     ]
    }
   ],
   "source": [
    "def great(msg) :\n",
    "    print(\"in great: \" + msg)\n",
    "    return msg + \"!\"\n",
    "\n",
    "print(great(\"안녕\"))"
   ]
  }
 ],
